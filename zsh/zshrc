# shell-config zsh entrypoint — installed as ~/.zshrc (symlink)

if [[ -z "${SHELL_CONFIG_DIR:-}" ]]; then
  if [[ -f "$HOME/.config/shell-config/path" ]]; then
    SHELL_CONFIG_DIR="$(<"$HOME/.config/shell-config/path")"
  else
    SHELL_CONFIG_DIR="$HOME/.local/share/shell-config"
  fi
fi

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"

if [[ -f "$SHELL_CONFIG_DIR/zsh/omz.zsh" ]]; then
  source "$SHELL_CONFIG_DIR/zsh/omz.zsh"
fi

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

[[ -f "$SHELL_CONFIG_DIR/zsh/env.zsh" ]] && source "$SHELL_CONFIG_DIR/zsh/env.zsh"
[[ -f "$SHELL_CONFIG_DIR/zsh/aliases.zsh" ]] && source "$SHELL_CONFIG_DIR/zsh/aliases.zsh"
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"