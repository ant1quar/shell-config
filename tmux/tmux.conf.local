# Local tmux configuration - overrides for gpakosz/.tmux
# This file is automatically sourced by the main config

# ============================================================
# Mouse: enable and configure for proper nvim integration
# ============================================================
set -g mouse on

# Improve mouse scrolling in nvim and other alternate-screen apps
# tmux 3.3+ automatically passes mouse to alternate screen apps
# but we can tune the behavior

# Number of lines to scroll per mouse wheel tick (default 5)
set -g @scroll-speed-num-lines-per-scroll 3

# Don't enter copy mode on scroll when mouse is over a pane with alternate screen
# (nvim, less, man pages, etc.) - this is default in tmux 3.3+
# set -g @scroll-in-moused-over-pane on

# ============================================================
# Terminal: ensure proper alternate screen support
# ============================================================
# Use xterm-keys for better key detection
set -g xterm-keys on

# Enable focus events for nvim (autoread, etc.)
set -g focus-events on

# ============================================================
# Clipboard: better integration with macOS
# ============================================================
# Use system clipboard (requires tmux-yank or similar)
# set -g set-clipboard on

# ============================================================
# Performance: reduce escape-time for nvim
# ============================================================
set -sg escape-time 10

# ============================================================
# Window/Pane: start indexing at 1
# ============================================================
set -g base-index 1
setw -g pane-base-index 1

# Renumber windows when one is closed
set -g renumber-windows on

# ============================================================
# History: increase scrollback
# ============================================================
set -g history-limit 50000

# ============================================================
# Visual: better colors for nvim
# ============================================================
# Ensure 24-bit color support
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"

# ============================================================
# Key bindings: easier pane navigation
# ============================================================
# vim-style pane switching (prefix + hjkl)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# ============================================================
# Reload config
# ============================================================
bind r source-file ~/.tmux.conf \; display "Config reloaded!"